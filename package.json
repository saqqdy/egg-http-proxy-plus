{
  "name": "egg-http-proxy-plus",
  "description": "A powerful HTTP proxy middleware plugin for Egg.js with TypeScript support",
  "version": "2.1.0",
  "main": "app.js",
  "types": "index.d.ts",
  "files": [
    "app",
    "config",
    "app.js",
    "index.d.ts"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run lint && egg-bin test",
    "test:local": "egg-bin test",
    "cov": "egg-bin cov",
    "ci": "npm run lint && npm run cov"
  },
  "dependencies": {
    "egg-path-matching": "^1.2.0",
    "http-proxy-middleware": "^3.0.5",
    "js-cool": "^2.1.2",
    "koa-connect": "^2.1.1"
  },
  "devDependencies": {
    "egg": "^3.34.0",
    "egg-bin": "^6.13.0",
    "egg-ci": "^2.2.0",
    "egg-mock": "^5.15.2",
    "eslint": "^9.39.4",
    "express": "^4.22.1"
  },
  "peerDependencies": {
